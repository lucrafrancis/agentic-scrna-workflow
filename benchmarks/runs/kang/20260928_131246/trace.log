🔧 check_markers(genes=['CD3D', 'CD3E', 'CD4', 'CD8A', 'CD8B', 'IL7R', 'CCR7', 'SELL', 'NKG7', 'GNLY', 'KLRD1', 'CD14', 'LYZ', 'FCGR3A', 'MS4A7', 'MS4A1', 'CD79A', 'CD19', 'PPBP', 'PF4', 'GP9', 'TPSAB1', 'CPA3', 'KIT', 'HBB', 'GATA1', 'CD74', 'HLA-DRA', 'FCER1A', 'CLEC9A', 'IL3RA', 'GZMB', 'GZMK', 'TCF7', 'LEF1', 'S100A8', 'S100A9', 'ISG15', 'IFI6', 'MX1'])
